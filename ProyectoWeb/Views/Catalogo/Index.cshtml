@model ProyectoWeb.Models.Libro[]

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="container mt-4">
    <h2>Catálogo de Libros (Árbol Binario)</h2>
    <p class="text-muted">Listado ordenado por ISBN mediante recorrido InOrden.</p>

    <!-- Formulario de Búsqueda -->
    <form asp-controller="Catalogo" asp-action="Buscar" method="post" class="row g-3 mb-4">
        <div class="col-auto">
            <input type="number" name="isbn" class="form-control" placeholder="Buscar por ISBN..." required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-controller="Catalogo" asp-action="Index" class="btn btn-secondary">Mostrar Todos</a>
        </div>
    </form>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning">@ViewBag.Mensaje</div>
    }

    <!-- Tabla de Libros -->
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ISBN</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Categoría</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Length > 0)
            {
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.ISBN</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.Categoria</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay libros registrados en la estructura.</td>
                </tr>
            }
        </tbody>
    </table>
</div>